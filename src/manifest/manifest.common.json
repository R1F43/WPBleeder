{
  "manifest_version": 3,
  "name": "WPBleeder",
  "version": "1.0.0",
  "description": "WordPress reconnaissance for authorized security testing — by R1F43",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/passive-detect.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "WPBleeder"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
